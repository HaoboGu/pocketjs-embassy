{
  "app": {
    "entry": "app.tsx",
    "framework": "solid",
    "theme": {
      "keyframes": {
        "signal-pulse": {
          "0%,100%": {
            "opacity": 0.45
          },
          "50%": {
            "opacity": 1
          }
        },
        "signal-arrive": {
          "from": {
            "opacity": 0,
            "transform": "translateY(6px)"
          },
          "to": {
            "opacity": 1,
            "transform": "translateY(0px)"
          }
        }
      },
      "animation": {
        "signal-pulse": "signal-pulse 1800ms ease-in-out infinite",
        "signal-arrive": "signal-arrive 240ms ease-out both"
      }
    }
  }
}
