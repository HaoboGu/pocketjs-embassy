+                            xy_word(x, y),
+                            wh_word(w, h),
+                            0x40ff_0011,
+                            0xc022_ffff,
+                            spec::GradDir::ToBottom as u32,
+                        ]),
+                        2 => words.extend_from_slice(&[
+                            draw_op::TEX_QUAD,
+                            texture as u32,
+                            xy_word(x, y),
+                            wh_word(w, h),
+                            0,
+                            0,
